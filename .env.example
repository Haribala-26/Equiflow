# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://equiflow:equiflow_secure_password@localhost:5432/equiflow_db?schema=public"

# Data Source Switcher: "mock" (default, zero-setup in-memory) or "prisma" (PostgreSQL)
DATA_SOURCE="mock"

# AI Decision Engine (Optional: system includes deterministic offline fallback if omitted)
GEMINI_API_KEY=""

# Session Security Secret for Role Guarding
SESSION_SECRET="equiflow_demo_session_secret_min_32_characters_random"

# Application Port
PORT=3000
